---
import Base from '../layouts/Base.astro';
---
<Base noindex title="Page not found — Naren Anandan" description="This page does not exist.">
<main class="hero hero--404 wrap" id="main">
  <div class="hero__text">
    <p class="eyebrow mono">404 · route not found</p>
    <h1 class="hero__title">Nothing deployed here<span class="accent">.</span></h1>
    <p class="hero__lede">That page doesn't exist. Everything is on the front page.</p>
    <div class="actions"><a class="btn btn--primary" href="/">Back to the front page</a></div>
  </div>
</main>
</Base>
